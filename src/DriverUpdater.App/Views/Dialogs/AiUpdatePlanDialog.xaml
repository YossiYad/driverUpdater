<ui:FluentWindow x:Class="DriverUpdater.App.Views.Dialogs.AiUpdatePlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DriverUpdater.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AiUpdatePlanViewModel}"
        Title="{DynamicResource AiPlan.Title}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="720"
        Height="680"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="56"
                     Padding="20,0"
                     Title="{DynamicResource AiPlan.Title}"
                     Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                     ButtonsForeground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                     ButtonsBackground="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                     ShowMinimize="True"
                     ShowMaximize="False"
                     CanMaximize="False"
                     ShowClose="True" />

        <Grid Grid.Row="1" Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource AiPlan.Heading}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource AiPlan.Subheading}"
                       FontSize="13"
                       Opacity="0.75"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Endorsed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14,12"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Top"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="12"
                                                       Opacity="0.75"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding VersionText, Mode=OneWay}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding SourceText, Mode=OneWay}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding RiskText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Reason}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander Margin="0,6,0,0"
                              Header="{Binding SkippedHeaderText}"
                              Visibility="{Binding HasSkipped, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Skipped}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DeviceName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Opacity="0.75"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Reason}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock FontSize="12"
                           Opacity="0.75"
                           Text="{Binding ToleranceText}" />
                <CheckBox Margin="0,10,0,0"
                          IsChecked="{Binding DoNotShowAgain, Mode=TwoWay}"
                          Content="{DynamicResource AiPlan.DoNotShowAgain}" />
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           FontSize="12"
                           Opacity="0.75"
                           Text="{Binding SelectionText}" />
                <Button MinWidth="100"
                        Content="{DynamicResource AiPlan.CancelButton}"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button MinWidth="140"
                        Margin="8,0,0,0"
                        Content="{DynamicResource AiPlan.InstallButton}"
                        IsDefault="True"
                        IsEnabled="{Binding HasSelection}"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="OnInstall" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
