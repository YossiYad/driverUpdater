<ui:FluentWindow x:Class="DriverUpdater.App.Views.DriverVersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DriverUpdater.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DriverVersionHistoryViewModel}"
        Title="DriverUpdater - Driver version history"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="640" Height="520"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Height="56"
                     Padding="20,0"
                     Title="DriverUpdater - Driver version history"
                     Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                     ButtonsForeground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                     ButtonsBackground="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     CanMaximize="False"
                     ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="16,12,16,8">
            <TextBlock FontSize="15" FontWeight="SemiBold"
                       Text="{Binding DeviceName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Opacity="0.75" FontSize="12" Margin="0,2,0,0">
                <Run Text="Current version:" />
                <Run Text="{Binding CurrentVersionText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock TextWrapping="Wrap"
                       Opacity="0.8"
                       FontSize="13"
                       Margin="0,8,0,0"
                       Text="Every version this device was seen with is listed below. Restoring an older version backs up the current driver first, removes it, and lets Windows re-bind the older package that is still in the driver store. A restart may be needed before the change fully applies." />
        </StackPanel>

        <Border Grid.Row="2" Margin="16,0,16,0">
            <Grid>
                <ListBox ItemsSource="{Binding Versions}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Padding="12,4"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Restore this version"
                                        IsEnabled="{Binding IsInstallable}"
                                        Command="{Binding DataContext.RestoreVersionCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                        CommandParameter="{Binding}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VersionText}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DetailText}"
                                               Opacity="0.65"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.7"
                           Margin="24"
                           Text="No older versions recorded yet. The history fills up automatically as scans run over time."
                           Visibility="{Binding HasNoVersions, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="16,12,16,16" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Opacity="0.75"
                       FontSize="12"
                       MaxWidth="420"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
            <Button DockPanel.Dock="Right"
                    Padding="14,7"
                    Content="Close"
                    IsCancel="True"
                    Click="OnClose" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
